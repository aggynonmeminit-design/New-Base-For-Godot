; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="New Base"
config/description="My base for 2D Godot projects"
config/tags=PackedStringArray("2d", "base", "not_a_game")
run/main_scene="uid://8hxdt3rtgt7n"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/max_fps=144
config/icon="uid://b5kdg4273noi8"

[autoload]

Global="*uid://bw6dts1by6ksk"
SignalBus="*uid://jsqp3x6axiu"

[debug]

settings/stdout/print_fps=true
gdscript/warnings/unused_parameter=0
gdscript/warnings/unused_signal=0
gdscript/warnings/untyped_declaration=1

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/mode=2
window/stretch/mode="canvas_items"

[file_customization]

folder_colors={
"res://1- Systems/": "purple",
"res://2- General Assets/": "red",
"res://3- Entities/": "pink",
"res://4- Level/": "pink",
"res://5- Hud/": "pink"
}

[gui]

theme/default_font_multichannel_signed_distance_field=true
theme/custom="uid://ei2x2d0fc0ck"

